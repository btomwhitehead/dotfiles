# This is Git's per-user configuration file.
[user]
# Please adapt and uncomment the following lines:
name = Tom Whitehead
	email = b.tom.whitehead@gmail.com
[pull]
	rebase = false
[init]
	defaultBranch = main
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
